classDiagram
    class Owner {
        +str name
        +dict preferences
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +str details
        +List~Task~ tasks
        +add_task(task)
        +get_tasks()
    }

    class Task {
        +str description
        +datetime due_at
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +sort_by_time()
        +filter_tasks(pet_name, completed)
        +detect_conflicts()
        +complete_task(pet, task)
        +build_daily_plan(day, available_minutes)
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : accesses
